---
import Image from "@core-elements/image/Image.astro";
import { productUrl, type Product } from "@component-utils/collections";

/** Product card used by the Product Library, the featured carousel and "You might also like". */
const {
  product,
  size = "md",
  headingLevel = "h3",
} = Astro.props as {
  product: Product;
  size?: "md" | "sm";
  headingLevel?: "h2" | "h3";
};
const p = product.data;
const Heading = headingLevel;
---

<article class:list={["product-card", `product-card--${size}`]}>
  <Image
    source={p.image}
    alt={p.imageAlt || p.title}
    aspectRatio="square"
    sizes="(min-width: 1280px) 300px, (min-width: 768px) 33vw, 100vw"
    widths={[300, 450, 600]}
  />
  <div class="product-card__body">
    <div>
      <Heading class="product-card__title">{p.title}</Heading>
      {p.summary && <p class="product-card__summary">{p.summary}</p>}
    </div>
    <a
      class="collection-card__link"
      href={productUrl(product)}
      aria-label={`Explore ${p.title}`}
    >
      Explore
      <svg
        width="32"
        height="16"
        viewBox="0 0 32 16"
        fill="none"
        aria-hidden="true"
        focusable="false"
      >
        <line
          x1="2"
          y1="8"
          x2="28"
          y2="8"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        ></line>
        <polyline
          points="22,3 28,8 22,13"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></polyline>
      </svg>
    </a>
  </div>
</article>

<style is:global>
  @layer components {
    .product-card {
      background: #fff;
      border-radius: 16px;
      color: var(--brand-navy);
      display: flex;
      flex-direction: column;
      height: 100%;
      overflow: hidden;
      text-align: left;
      width: 100%;

      img {
        aspect-ratio: 1;
        object-fit: cover;
        width: 100%;
      }
    }

    .product-card__body {
      display: flex;
      flex: 1;
      flex-direction: column;
      justify-content: space-between;
      padding: 24px;
    }

    .product-card__title {
      color: var(--brand-navy);
      font-family: var(--font-family-heading);
      font-size: 28.288px;
      font-weight: 600;
      line-height: 1.17;
      margin: 0 0 22.4px;
    }

    .product-card--sm .product-card__title {
      font-size: 21.632px;
      line-height: 28px;
      margin-bottom: 12px;
    }

    .product-card__summary {
      color: var(--brand-navy);
      font-size: 16px;
      line-height: 28px;
      margin: 0 0 22.4px;
    }
  }
</style>
