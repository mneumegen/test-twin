---
import Heading from "@core-elements/heading/Heading.astro";
import Accordion from "@wrappers/accordion/Accordion.astro";

const { heading, items = [], _component, ...htmlAttributes } = Astro.props;
---

<div
  class="faq-accordion__category"
  {...htmlAttributes}
>
  <Heading
    level="h2"
    size="fluid-h2"
    alignmentHorizontal="start"
    text={heading}
    data-prop="heading"
  />
  <Accordion
    label={heading}
    singleOpen={false}
    openFirst={false}
    titleHeadingLevel="h3"
    items={items}
    data-children-prop="items"
  />
</div>
