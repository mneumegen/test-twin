---
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Form from "@building-blocks/forms/form/Form.astro";
import Hidden from "@building-blocks/forms/hidden/Hidden.astro";
import Input from "@building-blocks/forms/input/Input.astro";
import Submit from "@building-blocks/forms/submit/Submit.astro";
import CustomSection from "@builders/custom-section/CustomSection.astro";

const {
  eyebrow,
  heading,
  body,
  formAction,
  contentId,
  redirectUrl,
  passwordLabel,
  passwordPlaceholder,
  submitText,
  maxContentWidth,
  paddingHorizontal,
  paddingVertical,
  colorScheme,
  backgroundColor,
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;
---

<CustomSection
  class:list={["password-gate", className]}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  backgroundColor={backgroundColor}
  {...htmlAttributes}
>
  <SimpleText
    text={eyebrow}
    variant="label"
    size="body"
    alignmentHorizontal="center"
    class="password-gate__eyebrow"
    data-prop="eyebrow"
  />
  <Heading
    text={heading}
    level="h1"
    size="fluid-h1"
    alignmentHorizontal="center"
    data-prop="heading"
  />
  <SimpleText
    text={body}
    size="body"
    alignmentHorizontal="center"
    class="password-gate__body"
    data-prop="body"
  />
  <Form
    action={formAction}
    class="password-gate__form"
  >
    <Hidden
      name="content_id"
      value={contentId}
    />
    <Hidden
      name="redirect_url"
      value={redirectUrl}
    />
    <Input
      type="password"
      name="password"
      label={passwordLabel}
      placeholder={passwordPlaceholder}
      required={false}
      autofocus={true}
    />
    <Submit
      text={submitText}
      variant="pill-flat"
      size="md"
      data-prop="submitText"
    />
  </Form>
</CustomSection>

<style is:global>
  @layer page-sections {
    .password-gate {
      border: 0 solid rgb(229, 231, 235);
    }
  }

  @layer overrides {
    .password-gate > .outer-content > .content {
      @media (width < 640px) {
        &.pad-y-6xl {
          padding-block: var(--spacing-6xl);
        }
      }
    }

    .password-gate .password-gate__eyebrow.simple-text {
      border: 0 solid rgb(229, 231, 235);
      margin-bottom: var(--spacing-md);
      margin-top: 0;
      outline-color: rgb(24, 62, 102);

      > .simple-text-content.variant-label {
        color: var(--color-text-strong);
        margin-bottom: var(--spacing-md);
        text-decoration-color: rgb(24, 62, 102);
      }
    }

    .password-gate .heading {
      border: 0 solid rgb(229, 231, 235);
      margin-bottom: 22.4px;
      margin-top: 0;
    }

    .password-gate .password-gate__body.simple-text {
      border: 0 solid rgb(229, 231, 235);
      margin-bottom: 22.4px;
      margin-top: 0;
      outline-color: rgb(24, 62, 102);

      > .simple-text-content {
        color: var(--color-text-strong);
        font-family: var(--font-family-body);
        font-weight: var(--font-weight-normal);
        margin-bottom: 22.4px;
        text-decoration-color: rgb(24, 62, 102);
        text-transform: none;
      }
    }

    .password-gate .password-gate__form.form {
      margin-top: 0;
      padding-top: var(--spacing-md);

      > div {
        align-items: center;
        display: flex;
        flex-direction: row;
        flex-wrap: nowrap;
        gap: var(--spacing-sm);
      }

      .input {
        flex: 1 1 auto;
        margin: 0;
        min-width: 0;

        .label {
          border: 0 solid rgb(229, 231, 235);
          clip: rect(0 0 0 0);
          color: var(--color-text-strong);
          font-family: var(--font-family-body);
          font-size: var(--font-size-sm);
          font-weight: var(--font-weight-normal);
          height: 1px;
          line-height: 19.6px;
          margin-bottom: var(--spacing-xs);
          outline-color: rgb(24, 62, 102);
          overflow: hidden;
          position: absolute;
          text-align: center;
          text-decoration-color: rgb(24, 62, 102);
          text-transform: none;
          width: 1px;
        }

        .field {
          border: 0 solid rgb(229, 231, 235);
          border-radius: var(--radius-full);
          box-shadow: none;
          font-size: var(--font-size-sm);
          height: 40px;
          line-height: 19.6px;
          outline: none;
          padding: 20px;
          transition: all 0s ease;

          &::placeholder {
            color: rgb(156, 163, 175);
            opacity: 1;
          }

          &:focus-visible {
            border: 2px solid rgb(214, 234, 235);
            box-shadow: none;
            outline: 2px solid rgb(214, 234, 235);
          }
        }
      }

      .submit {
        align-items: normal;
        border-color: rgb(229, 231, 235);
        display: block;
        flex: 0 0 auto;
        gap: normal;
        justify-content: normal;
        margin-top: 0;
        transition: all 0.15s linear;

        > .button-inner {
          text-transform: none;
          transition: all 0.15s linear;
        }
      }
    }
  }
</style>
