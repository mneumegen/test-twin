---
import Heading from "@core-elements/heading/Heading.astro";
import Image from "@core-elements/image/Image.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";

const {
  imageSource = "",
  imageAlt = "",
  title = "",
  description = "",
  _component,
  ...htmlAttributes
} = Astro.props;
---

<div
  class="experience-feature-grid__item"
  {...htmlAttributes}
>
  <Image
    source={imageSource}
    alt={imageAlt}
    priority={false}
    autoSizes={false}
    sizes="64px"
    widths={[64, 128]}
    class="experience-feature-grid__item-image"
    data-prop-src="imageSource"
    data-prop-alt="imageAlt"
  />
  <div class="experience-feature-grid__item-text">
    <Heading
      text={title}
      level="h3"
      size="fluid-h4"
      alignmentHorizontal="start"
      class="experience-feature-grid__item-title"
      data-prop="title"
    />
    <SimpleText
      text={description}
      size="body"
      alignmentHorizontal="start"
      class="experience-feature-grid__item-description"
      data-prop="description"
    />
  </div>
</div>
