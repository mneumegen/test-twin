---
import Component from "@components/utils/renderBlock.astro";
import {
  firstHeadingSlug,
  firstHeadingSlugFromBlocks,
  reserveSectionId,
} from "@components/utils/sectionAnchor";
import { slugifyLabel } from "@components/utils/slugify";
import Image from "@core-elements/image/Image.astro";
import Video from "@core-elements/video/Video.astro";

const {
  label,
  contentSections,
  maxContentWidth,
  paddingHorizontal,
  paddingVertical = "4xl",
  colorScheme = "inherit",
  lockColorScheme = false,
  backgroundColor,
  background,
  rounded = false,
  useDefaultEditableBinding = false,
  class: className,
  _component,
  "data-children-prop": childrenDataProp,
  ...htmlAttributes
} = Astro.props;

const {
  type: bgType = "image",
  positionVertical = "top",
  positionHorizontal = "center",
  priority = false,
  imageSource = "",
  imageAlt = "",
  videoSource = "",
  overlay = 0,
} = background || {};

const hasContentSections = contentSections !== undefined;

// INVARIANT: sections derive stable anchor ids (explicit id > label > first heading) so same-page #anchor links resolve; explicit ids are never mutated.
let renderedSlot: string | null = null;

if (htmlAttributes.id) {
  reserveSectionId(Astro.request, htmlAttributes.id);
} else {
  let anchorBase = label
    ? /^[a-z0-9]+(?:-+[a-z0-9]+)*$/.test(label)
      ? label
      : slugifyLabel(label)
    : "";

  if (!anchorBase && Astro.slots.has("default")) {
    renderedSlot = await Astro.slots.render("default");
    anchorBase = firstHeadingSlug(renderedSlot);
  }
  if (!anchorBase && hasContentSections) {
    anchorBase = firstHeadingSlugFromBlocks(contentSections);
  }
  if (anchorBase) {
    htmlAttributes.id = reserveSectionId(Astro.request, anchorBase);
  }
}
const effectiveChildrenProp =
  childrenDataProp ?? (useDefaultEditableBinding ? "contentSections" : null);
const arrayDataAttributes =
  effectiveChildrenProp && hasContentSections
    ? { "data-editable": "array", "data-prop": effectiveChildrenProp }
    : {};
---

<section
  class:list={["custom-section", className]}
  {...htmlAttributes}
>
  <div
    class:list={["outer-content", rounded && "rounded"]}
    data-theme={colorScheme && colorScheme !== "inherit" ? colorScheme : undefined}
    data-theme-lock={lockColorScheme || undefined}
  >
    {bgType === "image" && (
      <Image
        class:list={["background-image"]}
        source={imageSource}
        alt={imageAlt}
        priority={priority}
        positionVertical={positionVertical}
        positionHorizontal={positionHorizontal}
        background={true}
      />
    )}
    {bgType === "video" && (
      <Video
        type="local-source"
        source={videoSource}
        background={true}
        style={{ "--background-position": `${positionHorizontal} ${positionVertical}` }}
      />
    )}
    {overlay !== 0 && (
      <div
        class="background-overlay"
        aria-hidden="true"
        style={{
          backgroundColor: `rgba(${overlay < 0 ? "0, 0, 0" : "255, 255, 255"}, ${Math.abs(overlay)})`,
        }}
      />
    )}
    {backgroundColor && (
      <div class:list={["background", backgroundColor && `bg-${backgroundColor}`]} />
    )}

    <div
      class:list={[
        "content",
        paddingHorizontal && `pad-x-${paddingHorizontal}`,
        paddingVertical && `pad-y-${paddingVertical}`,
        maxContentWidth && `max-width-${maxContentWidth}`,
      ]}
      {...arrayDataAttributes}
    >
      {renderedSlot !== null ? (
        <Fragment set:html={renderedSlot} />
      ) : (
        <slot>
          {contentSections && (
            <Component
              contentSections={contentSections}
              useDefaultEditableBinding={!!effectiveChildrenProp}
            />
          )}
        </slot>
      )}
    </div>
  </div>
</section>

<style is:global>
  @layer components {
    .custom-section {
      > .outer-content {
        height: 100%;
        position: relative;

        &.rounded {
          border-radius: var(--radius-xl);
          overflow: hidden;
        }

        > .content {
          container-type: inline-size;
          height: 100%;
          margin-inline: auto;
          position: relative;
          z-index: var(--layer-1);

          > *:first-child {
            margin-top: 0;
          }

          > *:last-child {
            margin-bottom: 0;
          }

          &.pad-x-xs {
            padding-inline: var(--spacing-xs);
          }

          &.pad-x-sm {
            padding-inline: var(--spacing-sm);
          }

          &.pad-x-md {
            padding-inline: var(--spacing-md);
          }

          &.pad-x-lg {
            padding-inline: var(--spacing-lg);
          }

          &.pad-x-xl {
            padding-inline: var(--spacing-xl);
          }

          &.pad-x-2xl {
            padding-inline: var(--spacing-2xl);
          }

          &.pad-x-3xl {
            padding-inline: var(--spacing-3xl);
          }

          &.pad-x-4xl {
            padding-inline: var(--spacing-4xl);
          }

          &.pad-x-5xl {
            padding-inline: var(--spacing-5xl);
          }

          &.pad-x-6xl {
            padding-inline: var(--spacing-6xl);
          }

          &.pad-y-xs {
            padding-block: var(--spacing-xs);
          }

          &.pad-y-sm {
            padding-block: var(--spacing-sm);
          }

          &.pad-y-md {
            padding-block: var(--spacing-md);
          }

          &.pad-y-lg {
            padding-block: var(--spacing-lg);
          }

          &.pad-y-xl {
            padding-block: var(--spacing-xl);
          }

          &.pad-y-2xl {
            padding-block: var(--spacing-2xl);
          }

          &.pad-y-3xl {
            padding-block: var(--spacing-3xl);
          }

          &.pad-y-4xl {
            padding-block: var(--spacing-4xl);
          }

          &.pad-y-5xl {
            padding-block: var(--spacing-5xl);
          }

          &.pad-y-6xl {
            padding-block: var(--spacing-6xl);
          }

          @media (width < 640px) {
            &.pad-y-xs {
              padding-block: var(--spacing-xs);
            }

            &.pad-y-sm {
              padding-block: var(--spacing-xs);
            }

            &.pad-y-md {
              padding-block: var(--spacing-sm);
            }

            &.pad-y-lg {
              padding-block: var(--spacing-md);
            }

            &.pad-y-xl {
              padding-block: var(--spacing-md);
            }

            &.pad-y-2xl {
              padding-block: var(--spacing-lg);
            }

            &.pad-y-3xl {
              padding-block: var(--spacing-xl);
            }

            &.pad-y-4xl {
              padding-block: var(--spacing-2xl);
            }

            &.pad-y-5xl {
              padding-block: var(--spacing-3xl);
            }

            &.pad-y-6xl {
              padding-block: var(--spacing-4xl);
            }
          }

          &.max-width-none {
            max-width: none;
          }

          &.max-width-xs {
            max-width: var(--content-width-xs);
          }

          &.max-width-sm {
            max-width: var(--content-width-sm);
          }

          &.max-width-md {
            max-width: var(--content-width-md);
          }

          &.max-width-lg {
            max-width: var(--content-width-lg);
          }

          &.max-width-xl {
            max-width: var(--content-width-xl);
          }

          &.max-width-2xl {
            max-width: var(--content-width-2xl);
          }

          &.max-width-3xl {
            max-width: var(--content-width-3xl);
          }
          /* Adapted (Phase 2.5): source container width */
          &.max-width-512px {
            max-width: var(--content-width-512px);
          }

          /* Adapted (Phase 2.5): source container width */
          &.max-width-576px {
            max-width: var(--content-width-576px);
          }

          /* Adapted (Phase 2.5): source container width */
          &.max-width-672px {
            max-width: var(--content-width-672px);
          }

          /* Adapted (Phase 2.5): source container width */
          &.max-width-896px {
            max-width: var(--content-width-896px);
          }
        }

        > .background-overlay {
          inset: 0;
          position: absolute;
          z-index: var(--layer-1);
        }

        > .background {
          inset: 0;
          position: absolute;
        }

        > .background-image {
          z-index: var(--layer-1);
        }

        > .background-video {
          z-index: var(--layer-1);
        }

        > .bg-base {
          background-color: var(--color-bg);
        }

        > .bg-surface {
          background-color: var(--color-bg-surface);
        }

        > .bg-accent {
          background-color: var(--color-bg-accent);
        }

        > .bg-highlight {
          background-color: var(--color-bg-highlight);
        }

        /* Adapted (Phase 2.5): Twincraft surfaces — .bg-grid is the source 40px blueprint grid */
        > .bg-sky {
          background-color: var(--color-bg-sky);
        }

        > .bg-mint {
          background-color: var(--color-bg-mint);
        }

        > .bg-mint-strong {
          background-color: var(--color-bg-mint-strong);
        }

        > .bg-peach {
          background-color: var(--color-bg-peach);
        }

        > .bg-mint-grid {
          background-color: var(--color-bg-mint);
          background-image:
            linear-gradient(90deg, var(--color-bg-mint-line) 1px, transparent 0),
            linear-gradient(180deg, var(--color-bg-mint-line) 1px, transparent 0);
          background-size: 40px 40px;
        }
      }
    }
  }
</style>
