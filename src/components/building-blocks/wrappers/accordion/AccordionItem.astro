---
import RenderBlock from "@components/utils/renderBlock.astro";
import Icon from "@core-elements/icon/Icon.astro";

const {
  title,
  contentSections,
  useDefaultEditableBinding = false,
  isOpen = false,
  accordionName,
  titleHeadingLevel = "none",
  _component,
  class: className,
  "data-children-prop": childrenDataProp,
  ...htmlAttributes
} = Astro.props;

const effectiveChildrenProp =
  childrenDataProp ?? (useDefaultEditableBinding ? "contentSections" : null);
const arrayDataAttributes = effectiveChildrenProp
  ? { "data-editable": "array", "data-prop": effectiveChildrenProp }
  : {};

// Opt-in disclosure mode (adapted): titleHeadingLevel h2-h6 renders the row as
// a heading wrapping a button[aria-expanded][aria-controls] plus a role=region
// panel toggled via [hidden]. "none" (default) keeps the native details/summary
// markup byte-identical.
const DISCLOSURE_LEVELS = ["h2", "h3", "h4", "h5", "h6"];
const isDisclosure = DISCLOSURE_LEVELS.includes(titleHeadingLevel);
const HeadingTag = isDisclosure ? titleHeadingLevel : "h3";
const disclosureId = isDisclosure ? `accordion-item-${crypto.randomUUID()}` : "";
const triggerId = `${disclosureId}-trigger`;
const panelId = `${disclosureId}-panel`;
---

{isDisclosure ? (
  <div
    class:list={["accordion-item", "accordion-item--disclosure", className]}
    data-accordion-disclosure
    data-accordion-name={accordionName}
    data-open={isOpen ? "" : undefined}
    {...htmlAttributes}
  >
    <HeadingTag class="accordion-item-heading">
      <button
        type="button"
        class="accordion-item-title"
        id={triggerId}
        aria-expanded={isOpen ? "true" : "false"}
        aria-controls={panelId}
      >
        <span
          class="accordion-item-title-text"
          data-editable="text"
          data-prop="title"
        >
          {title}
        </span>
        <Icon
          name="chevron-down"
          size="none"
          class="accordion-item-icon"
        />
      </button>
    </HeadingTag>
    <div
      class="accordion-item-detail"
      id={panelId}
      role="region"
      aria-labelledby={triggerId}
      hidden={!isOpen}
      {...arrayDataAttributes}
    >
      <slot>
        {contentSections && (
          <RenderBlock
            contentSections={contentSections}
            useDefaultEditableBinding={!!effectiveChildrenProp}
          />
        )}
      </slot>
    </div>
  </div>
) : (
  <details
    class:list={["accordion-item", className]}
    open={isOpen}
    name={accordionName}
    {...htmlAttributes}
  >
    <summary class="accordion-item-title">
      <span
        class="accordion-item-title-text"
        data-editable="text"
        data-prop="title"
      >
        {title}
      </span>
      <Icon
        name="chevron-down"
        size="none"
        class="accordion-item-icon"
      />
    </summary>
    <div
      class="accordion-item-detail"
      {...arrayDataAttributes}
    >
      <slot>
        {contentSections && (
          <RenderBlock
            contentSections={contentSections}
            useDefaultEditableBinding={!!effectiveChildrenProp}
          />
        )}
      </slot>
    </div>
  </details>
)}

<script>
  // Disclosure-mode toggle (titleHeadingLevel h2-h6). Delegated on document so
  // CloudCannon live re-renders keep working; no-op for <details> items.
  const toggle = (item: HTMLElement, open: boolean) => {
    const trigger = item.querySelector<HTMLButtonElement>(
      ":scope > .accordion-item-heading > .accordion-item-title"
    );
    const panel = item.querySelector<HTMLElement>(":scope > .accordion-item-detail");
    if (!trigger || !panel) return;
    trigger.setAttribute("aria-expanded", open ? "true" : "false");
    panel.hidden = !open;
    item.toggleAttribute("data-open", open);
  };
  document.addEventListener("click", (event) => {
    const target = event.target as Element | null;
    const trigger = target?.closest?.(
      ".accordion-item--disclosure > .accordion-item-heading > .accordion-item-title"
    );
    if (!trigger) return;
    const item = trigger.closest<HTMLElement>(".accordion-item--disclosure");
    if (!item) return;
    const willOpen = trigger.getAttribute("aria-expanded") !== "true";
    const name = item.dataset.accordionName;
    if (willOpen && name) {
      document
        .querySelectorAll<HTMLElement>(".accordion-item--disclosure[data-accordion-name]")
        .forEach((other) => {
          if (other !== item && other.dataset.accordionName === name) toggle(other, false);
        });
    }
    toggle(item, willOpen);
  });
</script>

<style is:global>
  @layer components {
    .accordion-item {
      border-bottom: 1px solid var(--color-border-subtle);
      container-type: inline-size;

      > .accordion-item-title {
        align-items: center;
        cursor: pointer;
        display: flex;
        font-size: var(--font-size-xl);
        font-weight: var(--font-weight-bold);
        justify-content: space-between;
        padding: var(--spacing-md);
        transition: background-color var(--animation-normal) ease-out;
        -webkit-user-select: none;
        -ms-user-select: none;
        user-select: none;

        &:first-of-type {
          list-style-type: none;
        }

        &:hover {
          background-color: var(--color-bg-surface);
        }

        &::-webkit-details-marker {
          display: none;
        }

        .accordion-item-icon {
          transition: transform var(--animation-normal) ease-out;
        }
      }

      > .accordion-item-detail {
        padding-inline: var(--spacing-md);
        padding-bottom: var(--spacing-md);

        > *:first-child {
          margin-top: 0;
        }
      }
    }

    .accordion-item[open] {
      > .accordion-item-title .accordion-item-icon {
        transform: rotate(180deg);
      }

      &::details-content {
        animation: grow-out var(--animation-normal) ease-out;
      }
    }

    /* Disclosure mode (titleHeadingLevel h2-h6) - adapted, additive. Mirrors the
       summary title styling onto heading > button; resets UA heading/button chrome. */
    .accordion-item--disclosure {
      > .accordion-item-heading {
        color: inherit;
        font: inherit;
        margin: 0;
      }

      > .accordion-item-heading > .accordion-item-title {
        background: none;
        border: 0;
        align-items: center;
        color: inherit;
        cursor: pointer;
        display: flex;
        font-family: inherit;
        font-size: var(--font-size-xl);
        font-weight: var(--font-weight-bold);
        justify-content: space-between;
        line-height: inherit;
        padding: var(--spacing-md);
        text-align: start;
        transition: background-color var(--animation-normal) ease-out;
        width: 100%;
        -webkit-user-select: none;
        -ms-user-select: none;
        user-select: none;

        &:hover {
          background-color: var(--color-bg-surface);
        }

        .accordion-item-icon {
          transition: transform var(--animation-normal) ease-out;
        }

        &[aria-expanded="true"] .accordion-item-icon {
          transform: rotate(180deg);
        }
      }

      > .accordion-item-detail {
        padding-inline: var(--spacing-md);
        padding-bottom: var(--spacing-md);

        &[hidden] {
          display: none;
        }

        > *:first-child {
          margin-top: 0;
        }
      }
    }

    @supports (interpolate-size: allow-keywords) and selector(::details-content) {
      :root {
        interpolate-size: allow-keywords;
      }

      .accordion-item::details-content {
        height: 0;
        overflow: clip;
        transition:
          height var(--animation-normal) ease-out,
          content-visibility var(--animation-normal) ease-out allow-discrete;
      }

      .accordion-item[open]::details-content {
        height: auto;
      }

      .accordion-item[open] {
        &::details-content {
          animation: none;
        }
      }
    }
  }
</style>
