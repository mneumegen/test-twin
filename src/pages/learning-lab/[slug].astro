---
import PostImage from "@core-elements/post-image/PostImage.astro";
import Image from "@core-elements/image/Image.astro";
import CollectionBreadcrumb from "@page-sections/collections/breadcrumb/CollectionBreadcrumb.astro";
import PostList from "@page-sections/collections/post-list/PostList.astro";
import Page from "@layouts/Page.astro";
import templates from "@data/collectionTemplates.json";
import {
  authorName,
  authorUrl,
  getPosts,
  tagLabel,
  tagUrl,
  type Post,
} from "@component-utils/collections";
import { render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getPosts();

  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

const { post, posts } = Astro.props as { post: Post; posts: Post[] };
const { Content } = await render(post);
const d = post.data;
const t = templates.article;

// Related: newest articles sharing a tag, then newest overall.
const related = [
  ...posts.filter((p) => p.id !== post.id && p.data.tags.some((tag) => d.tags.includes(tag))),
  ...posts.filter((p) => p.id !== post.id && !p.data.tags.some((tag) => d.tags.includes(tag))),
].slice(0, 3);
const arrow = `<svg width="32" height="16" viewBox="0 0 32 16" fill="none" aria-hidden="true" focusable="false"><line x1="2" y1="8" x2="28" y2="8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><polyline points="22,3 28,8 22,13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---

<Page
  title={d.title}
  description={d.description}
  image={d.image}
  type="article"
  article={{
    publishedTime: d.publishedDate.toISOString(),
    modifiedTime: d.modifiedDate?.toISOString(),
    author: authorName(d.author).split(",")[0],
    tags: d.tags.map(tagLabel),
  }}
>
  <CollectionBreadcrumb
    items={[
      { label: "Home", href: "/" },
      { label: "The Learning Lab", href: "/learning-lab" },
      { label: d.title },
    ]}
  />
  <div class="article-wrap">
    <article class="article">
      {d.image && (
        <Image
          class="article__hero"
          source={d.image}
          alt={d.imageAlt}
          priority={true}
          sizes="(min-width: 1280px) 1216px, 100vw"
          widths={[640, 1216, 2432]}
        />
      )}
      <div class="article__inner">
        {d.tags.length > 0 && (
          <ul
            class="article__tags"
            role="list"
          >
            {d.tags.map((tag) => (
              <li>
                <a
                  class:list={["collection-tag", `collection-tag--${tag}`]}
                  href={tagUrl(tag)}
                >
                  {tagLabel(tag)}
                </a>
              </li>
            ))}
          </ul>
        )}
        <h1>{d.title}</h1>
        <p class="article__meta">
          <a href={authorUrl(d.author)}>{authorName(d.author).split(",")[0]}</a>
          <span aria-hidden="true"> · </span>
          <time datetime={d.publishedDate.toISOString()}>
            {d.publishedDate.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
              timeZone: "UTC",
            })}
          </time>
        </p>
        <div class="article__body">
          <Content components={{ PostImage }} />
        </div>
        <a
          class="collection-search-button article__contact"
          href={t.contactButtonLink}
        >
          {t.contactButtonText}
        </a>
      </div>
    </article>

    <aside class="article-closer">
      <div class="article-closer__text">
        <h2>{t.closer.heading}</h2>
        {t.closer.text.split(/\n\n+/).map((para) => (
          <p>{para}</p>
        ))}
        <a
          class="collection-card__link"
          href={t.closer.link}
        >
          {t.closer.linkText}
          <Fragment set:html={arrow} />
        </a>
      </div>
      <Image
        class="article-closer__image"
        source={t.closer.imageSource}
        alt={t.closer.imageAlt}
        sizes="(min-width: 768px) 50vw, 100vw"
        widths={[500, 1000]}
      />
    </aside>
  </div>

  <PostList
    heading={t.relatedHeading}
    posts={related}
    backgroundColor="sky"
  />
</Page>

<style is:global>
  @layer overrides {
    .article-wrap {
      margin: 0 auto;
      max-width: var(--content-width-2xl, 1280px);
      padding: 32px var(--spacing-lg) 80px;
    }

    .article__hero img {
      aspect-ratio: 16 / 9;
      border-radius: 16px;
      object-fit: cover;
      width: 100%;
    }

    .article__inner {
      color: var(--brand-navy);
      margin: 24px auto 0;
      max-width: 64rem;

      h1 {
        color: var(--brand-navy);
        font-size: clamp(2rem, 3.4vw, 42.851px);
        font-weight: 600;
        line-height: 1.17;
        margin: 24px 0 8px;
      }
    }

    .article__tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .article__meta {
      color: rgb(75 85 99);
      font-size: 14px;
      margin: 0 0 32px;

      a {
        color: inherit;
      }
    }

    .article__body {
      color: var(--brand-navy);
      font-size: 16px;
      line-height: 28px;

      &::after {
        clear: both;
        content: "";
        display: block;
      }

      p,
      li {
        line-height: 28px;
      }

      p {
        margin: 0 0 22.4px;
      }

      h2,
      h3,
      h4,
      h5,
      h6 {
        clear: none;
        color: var(--brand-navy);
        font-family: var(--font-family-heading);
        font-weight: 700;
        line-height: 1.3;
        margin: 0 0 22.4px;
      }

      h2 {
        font-size: 28.288px;
      }

      h3 {
        font-size: 24px;
      }

      h4,
      h5,
      h6 {
        font-size: 21.632px;
        line-height: 28px;
      }

      a {
        color: var(--brand-link);
      }

      table {
        background: var(--brand-sky);
        border-collapse: separate;
        border-radius: 16px;
        margin: 32px 0;
        width: 100%;
      }

      td {
        padding: 24px;
        vertical-align: top;
      }

      img {
        max-width: 100%;
      }
    }

    .article__contact {
      display: block;
      margin: 64px 0;
      text-align: center;
      text-decoration: none;
    }

    .article-closer {
      background: var(--brand-sky);
      border-radius: 16px;
      display: grid;
      overflow: hidden;

      @media (min-width: 768px) {
        grid-template-columns: 1fr 1fr;
      }

      h2 {
        color: var(--brand-navy);
        font-size: 28.288px;
        margin: 0 0 22.4px;
      }

      p {
        color: var(--brand-navy);
        line-height: 28px;
        margin: 0 0 22.4px;
      }
    }

    .article-closer__text {
      align-self: center;
      padding: 24px;

      @media (min-width: 1024px) {
        padding: 32px;
      }
    }

    .article-closer__image img {
      height: 100%;
      object-fit: cover;
      width: 100%;
    }
  }
</style>
