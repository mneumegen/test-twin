---
import { ClientRouter } from "astro:transitions";
import { fade } from "astro:transitions";
import SeoHead from "@components/utils/SeoHead.astro";
import StructuredData from "@components/utils/StructuredData.astro";
import seoData from "@data/seo.json";
import "@styles/style.css";
import SiteFonts from "@layouts/SiteFonts.astro";
import VideoElements from "@components/utils/VideoElements.astro";

export interface Props {
  title: string;
  description?: string | null;
  keywords?: string[] | null;
  image?: string | null;
  canonical?: string | null;
  type?: "website" | "article";
  article?: {
    publishedTime?: string | null;
    modifiedTime?: string | null;
    author?: string | string[] | null;
    tags?: string[] | null;
  } | null;
  noindex?: boolean;
}

const props = Astro.props;
---

<!doctype html>
<html
  lang="en"
  data-theme="light"
>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <link
      rel="shortcut icon"
      href="/Twincraft_Skincare_logo_final_GOOD_20COLOR.png"
    />
    <link
      rel="icon"
      href="/favicon.ico"
      type="image/x-icon"
    />
    <meta
      name="generator"
      content={Astro.generator}
    />
    <style is:inline>
      @layer reset, base, components, page-sections, utils, overrides;
    </style>

    <SiteFonts />

    {import.meta.env.DEV ? (
      <script
        type="module"
        src="/@vite/client"
      />
    ) : null}

    <script>
      if (window.inEditorMode) {
        document.documentElement.setAttribute("data-cc-editor", "");
        import("../../live-editing");
        import("../../editor-live-sync");
      }
    </script>

    <script>
      import { initScrollReveals } from "../components/utils/scroll-reveal";

      const init = () => initScrollReveals();

      if (document.readyState !== "loading") init();
      document.addEventListener("DOMContentLoaded", init);
      document.addEventListener("astro:page-load", init);
    </script>

    <SeoHead
      site={seoData}
      title={props.title}
      description={props.description}
      keywords={props.keywords}
      image={props.image}
      canonical={props.canonical}
      type={props.type}
      article={props.article}
      noindex={props.noindex}
    />

    <StructuredData site={seoData} />

    <link
      rel="sitemap"
      type="application/xml"
      title="Sitemap"
      href="/sitemap-index.xml"
    />

    <slot name="head" />
    <ClientRouter />
  </head>
  <body>
    <div transition:animate={fade({ duration: "0.2s" })}>
      <slot />
    </div>
    <VideoElements />
  </body>
</html>
