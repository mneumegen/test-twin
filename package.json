{
  "name": "astro-component-starter",
  "type": "module",
  "version": "1.0.2",
  "description": "A modern design system built with Astro, featuring design tokens, components, and comprehensive documentation",
  "keywords": ["design-system", "astro", "components", "css", "design-tokens"],
  "author": "Your Name",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "DISABLE_COMPONENT_LIBRARY=true astro build",
    "build:with-library": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "npm run lint && npm run format",
    "check:fix": "npm run lint:fix && npm run format:fix",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:yml",
    "lint:js": "eslint .",
    "lint:yml": "eslint \"**/*.{yml,yaml}\"",
    "lint:fix": "npm run lint:js:fix && npm run lint:css:fix && npm run lint:yml:fix",
    "lint:js:fix": "eslint . --fix",
    "lint:yml:fix": "eslint \"**/*.{yml,yaml}\" --fix",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "deps:sync": "rm -rf node_modules && npm install --os=linux --cpu=x64 --libc=glibc --ignore-scripts --no-audit && npm ci",
    "deps:check": "npm ci --dry-run"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/react": "^7.1.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@choctawnationofoklahoma/lite-vimeo": "^1.3.1",
    "@cloudcannon/editable-regions": "^0.0.22",
    "@justinribeiro/lite-youtube": "^1.9.0",
    "astro": "^7.4.7",
    "astro-icon": "^1.2.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-auto-scroll": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "markdown-it": "^15.0.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.2.1",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsonc": "^3.1.2",
    "eslint-plugin-yml": "^3.3.1",
    "jsonc-eslint-parser": "^3.1.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^1.1.2",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-order": "^8.1.3",
    "yaml-eslint-parser": "^2.0.0"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "optionalDependencies": {
    "@img/sharp-linux-x64": "^0.35.5",
    "@img/sharp-linuxmusl-x64": "^0.35.5"
  }
}
